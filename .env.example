# 生产环境变量模板
# 复制本文件为 .env，填入真实值，.env 已被 .gitignore 忽略，不会提交
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env 填入真实值
#   docker compose --env-file .env up -d

# ── MySQL ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=替换为强密码
MYSQL_PORT=3306

# ── account-a-service ────────────────────────────────────
ACCOUNT_A_DB_URL=jdbc:mysql://localhost:3306/account_a?useSSL=true&serverTimezone=UTC&characterEncoding=utf8
ACCOUNT_A_DB_USERNAME=替换为数据库用户名
ACCOUNT_A_DB_PASSWORD=替换为强密码

# ── account-b-service ────────────────────────────────────
ACCOUNT_B_DB_URL=jdbc:mysql://localhost:3306/account_b?useSSL=true&serverTimezone=UTC&characterEncoding=utf8
ACCOUNT_B_DB_USERNAME=替换为数据库用户名
ACCOUNT_B_DB_PASSWORD=替换为强密码

# ── transfer-service ─────────────────────────────────────
TRANSFER_DB_URL=jdbc:mysql://localhost:3306/transfer?useSSL=true&serverTimezone=UTC&characterEncoding=utf8
TRANSFER_DB_USERNAME=替换为数据库用户名
TRANSFER_DB_PASSWORD=替换为强密码

# ── 服务间调用地址（生产环境替换为实际主机名/域名）────────────
ACCOUNT_A_URL=http://account-a-service:8081
ACCOUNT_B_URL=http://account-b-service:8082
